                    $queryParams = array();
                    foreach (array('name', 'species', 'breed', 'color', 'status', 'description') as $key) {
                        if (isset($view->search_params[$key]) && !empty($view->search_params[$key])) {
                            $queryParams[$key] = $view->search_params[$key];
                        }
                    }
                    if (!empty($queryParams)) {
                        $queryParams['search'] = '1';
                    }
                    $baseQuery = http_build_query($queryParams);
                    ?>

                    <!-- this shows previous button if  person is not on first page -->
                    <?php if ($view->current_page > 1): ?>
                        <a href="browse.php?<?php echo $baseQuery; ?>&page=<?php echo $view->current_page - 1; ?>">Previous</a>
